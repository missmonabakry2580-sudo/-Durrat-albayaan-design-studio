{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amin",
  "version": "0.2.27",
  "identifier": "com.monaalsayedstudio.amin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "\u0623\u0645\u064a\u0646 \u2014 Amin",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; connect-src 'self' blob: https://api.simli.ai wss://api.simli.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "libaminvoice.dylib",
      "ECAPA_TDNN.mlpackage"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3QzQwOURBOENCMkNFMzUKUldRMXpyS00yZ25FSjR0cTkycWY0QTVReWJFc0cwbDBGSXhCZnVoV3dYSzdPT3hqYnMzZWlyZmcK",
      "endpoints": [
        "https://github.com/missmonabakry2580-sudo/-Durrat-albayaan-design-studio/releases/download/amin-preview/latest.json"
      ]
    }
  }
}

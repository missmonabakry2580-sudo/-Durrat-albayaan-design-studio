# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — see docs/SECURITY.md. It is a *dev convenience*
# only: the shipped app never reads secrets from .env files, it reads them
# from the OS Keychain via src-tauri/src/secrets.rs (see save_api_key /
# has_api_key / clear_api_key commands).

ANTHROPIC_API_KEY=
